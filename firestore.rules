rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100;
    }

    function isValidMission(data, userId) {
      return data.userId == userId &&
        data.id is string && isValidId(data.id) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.category in ['Personal', 'Study', 'Training', 'Wellbeing'] &&
        data.priority in ['low', 'medium', 'high'] &&
        data.status in ['active', 'completed', 'archived'];
    }

    function isValidTrainingRecord(data, userId) {
      return data.userId == userId &&
        data.id is string && isValidId(data.id) &&
        data.sport is string && data.sport.size() <= 60 &&
        data.title is string && data.title.size() <= 200 &&
        data.durationMinutes is number && data.durationMinutes >= 0 &&
        data.date is string && data.date.size() <= 30;
    }

    function isValidStudySession(data, userId) {
      return data.userId == userId &&
        data.id is string && isValidId(data.id) &&
        data.subjectName is string && data.subjectName.size() <= 100 &&
        data.durationMinutes is number && data.durationMinutes >= 0 &&
        data.date is string && data.date.size() <= 30;
    }

    function isValidSubject(data, userId) {
      return data.userId == userId &&
        data.id is string && isValidId(data.id) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100;
    }

    function isValidCalendarEvent(data, userId) {
      return data.userId == userId &&
        data.id is string && isValidId(data.id) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.type in ['exam', 'deadline', 'training', 'study', 'personal'] &&
        data.startDate is string && data.startDate.size() <= 64 &&
        data.status in ['scheduled', 'completed', 'cancelled'];
    }

    function isValidVisionPoster(data, userId) {
      return data.userId == userId &&
        data.id is string && isValidId(data.id) &&
        data.title is string && data.title.size() <= 150 &&
        data.imageUrl is string && data.imageUrl.size() <= 250000;
    }

    // User profile and subcollections
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidUserProfile(incoming(), userId);
      allow delete: if isOwner(userId);

      match /missions/{missionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(missionId) && isValidMission(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(missionId) && isValidMission(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(missionId);
      }

      match /trainingRecords/{recordId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(recordId) && isValidTrainingRecord(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(recordId) && isValidTrainingRecord(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(recordId);
      }

      match /studySessions/{sessionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(sessionId) && isValidStudySession(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(sessionId) && isValidStudySession(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(sessionId);
      }

      match /subjects/{subjectId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(subjectId) && isValidSubject(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(subjectId) && isValidSubject(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(subjectId);
      }

      match /calendarEvents/{eventId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(eventId) && isValidCalendarEvent(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(eventId) && isValidCalendarEvent(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(eventId);
      }

      match /visionPosters/{posterId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(posterId) && isValidVisionPoster(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(posterId) && isValidVisionPoster(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(posterId);
      }
    }
  }
}
